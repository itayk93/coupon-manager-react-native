<?xml version="1.0" encoding="utf-8"?>
<!-- Matches WidgetStyle.primaryGradient on iOS: #2C3F50 -> #405364 -> #2C3F50 diagonal. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#2C3F50"
        android:centerColor="#405364"
        android:endColor="#2C3F50" />
</shape>
