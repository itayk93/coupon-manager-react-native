<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the iOS systemMedium/systemLarge faces: optional header + coupon cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/widget_logo"
            android:contentDescription="@string/coupon_widget_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/header_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:fontFamily="@font/heebo_bold" />

            <TextView
                android:id="@+id/header_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="14sp" 
                android:fontFamily="@font/heebo_regular" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/widget_divider" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:visibility="gone"
        android:textColor="@color/widget_text_subtle"
        android:textSize="13sp" 
        android:fontFamily="@font/heebo_regular" />

    <LinearLayout
        android:id="@+id/card_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/widget_card_background">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/logo_1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/coupon_widget_description" />

            <TextView
                android:id="@+id/initials_1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_logo_fallback"
                android:textColor="@color/widget_code"
                android:textSize="15sp"
                android:fontFamily="@font/heebo_bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/company_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:fontFamily="@font/heebo_bold" />

            <TextView
                android:id="@+id/balance_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="11sp" 
                android:fontFamily="@font/heebo_regular" />
        </LinearLayout>

        <TextView
            android:id="@+id/code_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:background="@drawable/widget_code_background"
            android:textColor="@color/widget_code"
            android:textSize="10sp"
            android:fontFamily="@font/heebo_bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/widget_card_background">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/logo_2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/coupon_widget_description" />

            <TextView
                android:id="@+id/initials_2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_logo_fallback"
                android:textColor="@color/widget_code"
                android:textSize="15sp"
                android:fontFamily="@font/heebo_bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/company_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:fontFamily="@font/heebo_bold" />

            <TextView
                android:id="@+id/balance_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="11sp" 
                android:fontFamily="@font/heebo_regular" />
        </LinearLayout>

        <TextView
            android:id="@+id/code_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:background="@drawable/widget_code_background"
            android:textColor="@color/widget_code"
            android:textSize="10sp"
            android:fontFamily="@font/heebo_bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/widget_card_background">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/logo_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/coupon_widget_description" />

            <TextView
                android:id="@+id/initials_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_logo_fallback"
                android:textColor="@color/widget_code"
                android:textSize="15sp"
                android:fontFamily="@font/heebo_bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/company_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:fontFamily="@font/heebo_bold" />

            <TextView
                android:id="@+id/balance_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="11sp" 
                android:fontFamily="@font/heebo_regular" />
        </LinearLayout>

        <TextView
            android:id="@+id/code_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:background="@drawable/widget_code_background"
            android:textColor="@color/widget_code"
            android:textSize="10sp"
            android:fontFamily="@font/heebo_bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/widget_card_background">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/logo_4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/coupon_widget_description" />

            <TextView
                android:id="@+id/initials_4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_logo_fallback"
                android:textColor="@color/widget_code"
                android:textSize="15sp"
                android:fontFamily="@font/heebo_bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/company_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:fontFamily="@font/heebo_bold" />

            <TextView
                android:id="@+id/balance_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="11sp" 
                android:fontFamily="@font/heebo_regular" />
        </LinearLayout>

        <TextView
            android:id="@+id/code_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:background="@drawable/widget_code_background"
            android:textColor="@color/widget_code"
            android:textSize="10sp"
            android:fontFamily="@font/heebo_bold" />
    </LinearLayout>
</LinearLayout>
