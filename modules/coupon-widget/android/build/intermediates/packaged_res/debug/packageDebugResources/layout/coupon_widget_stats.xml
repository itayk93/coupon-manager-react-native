<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the iOS systemSmall face: logo, divider, two counters, total balance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/widget_logo"
        android:contentDescription="@string/coupon_widget_description" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="4dp"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coupon_widget_one_time"
                android:textColor="@color/widget_text_subtle"
                android:textSize="9sp" 
                android:fontFamily="@font/heebo_regular" />

            <TextView
                android:id="@+id/one_time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/widget_text"
                android:textSize="20sp"
                android:fontFamily="@font/heebo_extrabold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coupon_widget_active"
                android:textColor="@color/widget_text_subtle"
                android:textSize="9sp" 
                android:fontFamily="@font/heebo_regular" />

            <TextView
                android:id="@+id/active_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/widget_text"
                android:textSize="20sp"
                android:fontFamily="@font/heebo_extrabold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/total_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="₪0"
        android:textColor="@color/widget_text"
        android:textSize="30sp"
        android:fontFamily="@font/heebo_extrabold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/coupon_widget_remaining"
        android:textColor="@color/widget_text_subtle"
        android:textSize="13sp" 
        android:fontFamily="@font/heebo_regular" />
</LinearLayout>
