{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "expo-env.d.ts",
    "src/declarations.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/lib/**/*.test.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "web", "supabase", "tests", "scripts"]
}
