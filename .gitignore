# Local agent/editor config and internal notes — not part of the public repo
.claude/
.cursor/
.commandcode/
SECURITY_REVIEW.md
SESSION_*.md
AGENTS.md
CLAUDE.md
GEMINI.md
*.command.zip

# Intermediate frames the onboarding demo renderer writes before ffmpeg encodes
# the mp4 next to them. 124MB of regenerable PNGs; rerun
# scripts/render-onboarding-character-demos.py to get them back.
assets/onboarding/videos/*-frames/
.env*

# Multipass run output (regenerated by scripts)
multipass-*.json

# The iPhone the local build script last targeted. Machine state, not project
# configuration: another checkout has different hardware plugged in.
.ios-device
