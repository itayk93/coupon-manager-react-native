{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/declarations.d.ts",
    "src/components/**/*",
    "src/contexts/**/*",
    "src/hooks/**/*",
    "src/integrations/**/*",
    "src/lib/**/*",
    "src/navigation/**/*",
    "src/screens/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "supabase",
    "tests",
    "playwright",
    "src/pages"
  ],
  "extends": "expo/tsconfig.base"
}
