# Secrets for the Supabase Edge Functions.
# Set with: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform — do not set them here.

# Must match EXPO_PUBLIC_ENCRYPTION_KEY in the app.
ENCRYPTION_KEY=

# Email delivery (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Coupon parsing
OPENAI_API_KEY=

# Balance scraping service
SCRAPER_SERVICE_URL=
SCRAPER_SERVICE_TOKEN=

# Multipass update dispatched via a GitHub Actions workflow
GITHUB_TOKEN=
MULTIPASS_GH_OWNER=
MULTIPASS_GH_REPO=
MULTIPASS_GH_WORKFLOW=
MULTIPASS_GH_REF=
MULTIPASS_GH_INPUT_KEY=
MULTIPASS_GH_INPUT_SEPARATOR=

# Referrals. Salts the install fingerprint sent with a referral claim, so the
# stored hash cannot be matched back to a device by anyone holding the table.
# Unset means install ids are not stored at all, which loses the duplicate-
# account signal but never stores an unsalted one.
REFERRAL_INSTALL_PEPPER=

# Hardening
APP_BASE_URL=
CORS_ALLOWED_ORIGINS=
SSRF_ALLOWED_HOSTS=
ADMIN_IP_ALLOWLIST=
CANARY_TOKENS=
UNSUBSCRIBE_SECRET=
