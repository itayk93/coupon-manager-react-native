{
  "expo": {
    "name": "Coupon Master",
    "slug": "coupon-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "couponmaster",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itaykarkason.couponmaster",
      "appleTeamId": "TM252YSY6T",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.itaykarkason.couponmaster"]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "אפליקציה זו זקוקה לגישה למצלמה כדי לסרוק קודי קופון וברקודים.",
        "NSFaceIDUsageDescription": "אפליקציה זו משתמשת ב-Face ID כדי לפתוח את הארנק שלך בצורה מאובטחת."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf9f6"
      },
      "package": "com.itaykarkason.couponmaster",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf9f6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "אפליקציה זו זקוקה לגישה למצלמה כדי לסרוק קודי קופון וברקודים."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "אפליקציה זו משתמשת ב-Face ID כדי לפתוח את הארנק שלך בצורה מאובטחת."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets"
    ],
    "extra": {
      "supabaseUrl": "https://dugjsiyenazpsoiyduuz.supabase.co",
      "supabaseAnonKey": "REMOVED_PUBLIC_SUPABASE_ANON_KEY",
      "encryptionKey": "REMOVED_PUBLIC_ENCRYPTION_KEY=",
      "eas": {
        "projectId": "864f975d-b0a6-4e41-888a-bb60b26ae1fe"
      }
    },
    "owner": "itaykar",
    "updates": {
      "url": "https://u.expo.dev/864f975d-b0a6-4e41-888a-bb60b26ae1fe"
    }
  }
}
