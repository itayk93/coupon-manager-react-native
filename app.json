{
  "expo": {
    "name": "Coupon Master",
    "slug": "coupon-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "couponmaster",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itaykarkason.couponmaster",
      "appleTeamId": "TM252YSY6T",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.itaykarkason.couponmaster"]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "אפליקציה זו זקוקה לגישה למצלמה כדי לסרוק קודי קופון וברקודים.",
        "NSFaceIDUsageDescription": "אפליקציה זו משתמשת ב-Face ID כדי לפתוח את הארנק שלך בצורה מאובטחת.",
        "NSLocationWhenInUseUsageDescription": "האפליקציה משתמשת במיקום שלך כדי לרשום את המקום שבו השתמשת בקופון."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf9f6"
      },
      "package": "com.itaykarkason.couponmaster",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo-stacked.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "אפליקציה זו זקוקה לגישה למצלמה כדי לסרוק קודי קופון וברקודים.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "אפליקציה זו זקוקה לגישה לתמונות כדי לזהות פרטי שובר מצילום מסך.",
          "cameraPermission": "אפליקציה זו זקוקה לגישה למצלמה כדי לצלם שובר ולזהות את פרטיו.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "אפליקציה זו משתמשת ב-Face ID כדי לפתוח את הארנק שלך בצורה מאובטחת."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "האפליקציה משתמשת במיקום שלך רק לאחר לחיצה על 'המיקום שלי', כדי לרשום היכן השתמשת בקופון.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1f6fd1"
        }
      ],
      "./plugins/withQuotedBundleScript"
    ],
    "extra": {
      "eas": {
        "projectId": "864f975d-b0a6-4e41-888a-bb60b26ae1fe"
      }
    },
    "owner": "itaykar",
    "updates": {
      "url": "https://u.expo.dev/864f975d-b0a6-4e41-888a-bb60b26ae1fe"
    }
  }
}
