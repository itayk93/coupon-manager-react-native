{
  "expo": {
    "name": "Coupon Master",
    "slug": "coupon-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "couponmaster",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itaykarkason.couponmaster",
      "infoPlist": {
        "NSCameraUsageDescription": "אפליקציה זו זקוקה לגישה למצלמה כדי לסרוק קודי קופון וברקודים."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.itaykarkason.couponmaster",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "אפליקציה זו זקוקה לגישה למצלמה כדי לסרוק קודי קופון וברקודים."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "supabaseUrl": "https://dugjsiyenazpsoiyduuz.supabase.co",
      "supabaseAnonKey": "REMOVED_PUBLIC_SUPABASE_ANON_KEY",
      "encryptionKey": "REMOVED_PUBLIC_ENCRYPTION_KEY=",
      "eas": {
        "projectId": "864f975d-b0a6-4e41-888a-bb60b26ae1fe"
      }
    },
    "owner": "itaykar",
    "updates": {
      "url": "https://u.expo.dev/864f975d-b0a6-4e41-888a-bb60b26ae1fe"
    }
  }
}
