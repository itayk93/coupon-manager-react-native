# Copy to .env and fill in. Never commit the filled-in file.
#
# The app also reads these from `expo.extra` in app.json. Values set here
# override app.json at build time (see src/lib/encryption.ts and
# src/integrations/supabase/client.ts).

# --- Supabase project the app talks to ---
EXPO_PUBLIC_SUPABASE_URL=
# Anon key. Public by design — every table is protected by RLS, and the RPC
# surface is revoked down to service_role (supabase/migrations/0016_*).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Coupon-code encryption ---
# base64url-encoded 32-byte key. MUST match the ENCRYPTION_KEY secret set on
# the Supabase Edge Functions, or codes written by one side cannot be read by
# the other.
EXPO_PUBLIC_ENCRYPTION_KEY=

# --- Local automation email fallback (ignored local file: .env.brevo.local) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
MULTIPASS_SUMMARY_EMAIL_TO=
