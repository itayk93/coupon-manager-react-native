# Copy to .env and fill in. Never commit the filled-in file.

# --- App (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENCRYPTION_KEY=

# --- End-to-end tests (Playwright) ---
# Required: tests/global-setup.ts authenticates against the live Supabase
# project with these. There is deliberately no default in the source — a
# fallback literal here is a credential committed to the repo.
# Prefer a dedicated, seeded test account over a real user's login.
E2E_EMAIL=
E2E_PASSWORD=

# Optional: defaults to http://127.0.0.1:8080
E2E_BASE_URL=
# Optional: minimum coupon cards the seeded account must render (default 5)
E2E_MIN_COUPONS=
