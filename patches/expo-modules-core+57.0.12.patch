+/**
+ Holds a weak, non-`Sendable` emitter so it can cross into the `@JavaScriptActor` region. See the notes
+ on the `emit` overloads above for why this is safe: the scheduled closure only reaches
+ `@JavaScriptActor`-isolated or `Sendable` state through the emitter, never its own mutable state.
+ */
+internal final class UncheckedSendableWeakEmitterBox<Emitter: AnyObject>: @unchecked Sendable {
+  weak var value: Emitter?
+
+  init(_ value: Emitter) {
+    self.value = value
+  }
+}
